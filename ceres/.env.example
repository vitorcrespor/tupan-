# Copy this file to .env for the FastAPI service. Never commit .env or real keys.

# HTTP API
# Vite development normally runs at http://127.0.0.1:5173; 4173 and 4174 are
# supported local preview ports. Restrict these origins in production.
API_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:4174,http://localhost:4174
API_ALLOW_MOCK_DATA=false
# Keep legacy global property data disabled until every legacy record has a
# verified organization owner in the PostgreSQL tenant tables.
API_ALLOW_LEGACY_GLOBAL_DATA=false
TUPAN_ENV=development
TUPAN_API_VERSION=1.0.0
TUPAN_MINIMUM_CLIENT_VERSION=
FORWARDED_ALLOW_IPS=127.0.0.1
LOG_LEVEL=INFO

# Local persistent vector store used by the existing property ingestion/query code.
VECTOR_DB=./.tupan_chroma

# Provider-backed features. Properties/vector search use OpenAI embeddings;
# agent and Google Maps enrichment use Google services. Leave blank only if
# you do not invoke the corresponding routes.
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GOOGLE_MODEL=gemini-2.5-flash-lite
AI_MAX_EVIDENCE_BYTES=180000

# Existing agent and ingestion persistence. Create the logs directory before
# using these workflows, or choose absolute writable paths.
LOG_PATH=./logs/conversation.jsonl
TOOL_LOG_PATH=./logs/tools.jsonl
LOG_PATH_MOD=./logs/agent-context.txt
AGENT_TRACE_PATH=./logs/agent-trace.jsonl
HASH_LOG_PATH=./logs/ingestion-hashes.json
CONTEXT_SIZE=20

# Offline-trained XGBoost AVM artifacts. The valuation endpoint only loads and
# reuses these artifacts; it never initiates training.
# AVM_MODEL_PATH=C:/secure-models/avm_price.json
# AVM_MODEL_METADATA_PATH=C:/secure-models/avm_price.metadata.json
SEED=42

# Required only by explicit analytics/training scripts, never by an API request.
PARAM_LOG_PATH=./logs/analytics-parameters.json
TS_PARAM_LOG_PATH=./logs/time-series-parameters.json
OS_PARAM_LOG_PATH=./logs/optimization-parameters.json

# Tupan Cloud control plane. PostgreSQL with PostGIS + pgvector is the shared
# production source of truth. This administrative URL is for migrations and
# operator tooling only. Apply every pending migration with the explicit
# preview/apply workflow before enabling tenant data.
DATABASE_URL=postgresql://tupan_admin:change-me@127.0.0.1:5432/tupan
# The FastAPI process prefers this restricted, NO-BYPASSRLS role. It must not
# be exposed to the desktop and must have only application-table privileges.
DATABASE_API_URL=postgresql://tupan_api:change-me@127.0.0.1:5432/tupan
# Trusted offline/release process only. This role reads the minimum global
# source fields and publishes platform aggregates/model-training inputs.
# It never belongs in the desktop, FastAPI request process, or frontend build.
PLATFORM_INTELLIGENCE_DATABASE_URL=postgresql://tupan_platform_intelligence:change-me@127.0.0.1:5432/tupan

# Supabase Auth v2 staging. The FastAPI process is the only runtime that
# contacts Supabase Auth. The desktop continues to call FastAPI only.
# Apply backend/migrations/008_supabase_auth_v2.sql before enabling /api/v2.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_AUTH_TIMEOUT_SECONDS=10
# Local HTTP defaults. In Railway: AUTH_COOKIE_SECURE=true. A separately hosted
# desktop/web client requires AUTH_COOKIE_SAME_SITE=none and exact CORS origins.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_NAME=tupan_session
AUTH_SESSION_SECONDS=604800

# Dedicated backend worker database role/URL. For local-only development it
# may equal DATABASE_URL. Do not expose either connection string to the client.
WORKER_DATABASE_URL=
WORKER_CONCURRENCY=2
WORKER_POLL_SECONDS=1
WORKER_STALE_AFTER_SECONDS=900
WORKER_HEARTBEAT_SECONDS=30
WORKER_MAX_EXECUTION_SECONDS=1800
WORKER_SHUTDOWN_SECONDS=30
WORKER_LOG_LEVEL=INFO

# Bounded request-time fan-out/fan-in analysis. AVM CPU work remains off the
# asyncio event loop; non-interactive bulk work stays in the durable worker.
ANALYSIS_REQUEST_TIMEOUT_SECONDS=12
ANALYSIS_BRANCH_TIMEOUT_SECONDS=5
ANALYSIS_AVM_TIMEOUT_SECONDS=3
